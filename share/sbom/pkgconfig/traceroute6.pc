Name: traceroute6
Requires: csu, libc, libcapsicum, libcasper, libcasper.services.cap_dns, libcompiler_rt, libipsec
Source: https://cgit.freebsd.org/src/tree/usr.sbin/traceroute6${FREEBSD_GIT_QUERY}
URL: https://man.freebsd.org/cgi/man.cgi?query=traceroute6(8)${FREEBSD_MAN_QUERY}
Version: ${FREEBSD_RELEASE}
