	$(top_srcdir)/m4/lt~obsolete.m4 $(top_srcdir)/m4/memory.m4 \
	$(top_srcdir)/m4/signals.m4 $(top_srcdir)/m4/uname.m4 \
	$(top_srcdir)/configure.ac
am__configure_deps = $(am__aclocal_m4_deps) $(CONFIGURE_DEPENDENCIES) \
	$(ACLOCAL_M4)
DIST_COMMON = $(srcdir)/Makefile.am $(top_srcdir)/configure \
	$(am__configure_deps) $(dist_examples_DATA) $(dist_misc_DATA) \
	$(dist_store_DATA) $(am__DIST_COMMON)
