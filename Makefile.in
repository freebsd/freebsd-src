#
# Supporting logic to run our custom testsuite.
#
TESTS_ENVIRONMENT = PKG_CONFIG_PATH=$(prefix)/lib/pkgconfig \
	$(am__append_1) $(am__append_2)
@HAVE_ASAN_TRUE@@HAVE_LSAN_FALSE@LSAN_OPTIONS = 

# NB: the trailing comma is intentional. I hate automake not allowing `:=` use on subsequent lines.
@HAVE_ASAN_TRUE@@HAVE_LSAN_TRUE@LSAN_OPTIONS = detect_leaks=1,
# Some of the testcases trigger false positives as they pass
# `SIZE_MAX - 1`, etc, to malloc(3).
@HAVE_ASAN_TRUE@ASAN_OPTIONS = ${LSAN_OPTIONS}allocator_may_return_null=1
ACLOCAL_AMFLAGS = -I m4
CHECK_BOOTSTRAP_DEPS = $(am__append_7)
CHECK_KYUA_DEPS = $(am__append_8)
CHECK_LOCAL = $(am__append_5)
CLEAN_TARGETS = $(am__append_24)

# Replace Automake's builtin check-news functionality so that we can validate
# the NEWS file instead of NEWS.
DIST_HOOKS = $(am__append_20) check-news
PHONY_TARGETS = check-style $(am__append_6) $(am__append_9) \
	$(am__append_18) $(am__append_21) $(am__append_22) \
	$(am__append_23) check-news clean-all
CLEANFILES = $(am__append_10) doc/kyua-about.1 doc/kyua-config.1 \
	doc/kyua-db-exec.1 doc/kyua-db-migrate.1 doc/kyua-debug.1 \
	doc/kyua-help.1 doc/kyua-list.1 doc/kyua-report-html.1 \
	doc/kyua-report-junit.1 doc/kyua-report.1 doc/kyua-test.1 \
	doc/kyua.1 doc/kyua.conf.5 doc/kyuafile.5 $(am__append_13) \
	local-kyua local-kyua.tmp
EXTRA_DIST = $(doc_DATA) INSTALL.md README.md $(am__append_3) \
	admin/check-style-common.awk admin/check-style-cpp.awk \
	admin/check-style-make.awk admin/check-style-man.awk \
	admin/check-style-shell.awk admin/check-style.sh \
	$(am__append_4) $(DIST_MAN_DEPS) doc/kyua-about.1.in \
	doc/kyua-config.1.in doc/kyua-db-exec.1.in \
	doc/kyua-db-migrate.1.in doc/kyua-debug.1.in \
	doc/kyua-help.1.in doc/kyua-list.1.in \
	doc/kyua-report-html.1.in doc/kyua-report-junit.1.in \
	doc/kyua-report.1.in doc/kyua-test.1.in doc/kyua.1.in \
	doc/kyua.conf.5.in doc/kyuafile.5.in $(am__append_11) \
	utils/test_utils.ipp $(am__append_17)
noinst_DATA = INSTALL.md README.md
noinst_LTLIBRARIES = libcli.la libdrivers.la libengine.la \
	libengine_execenv.la libmodel.la libfreebsd.la libstore.la \
	libutils.la

# Generate local-kyua, a wrapper shell script to run the just-built 'kyua'
# binary by pointing it to the possibly not-yet-installed data files in the
# build tree.
noinst_SCRIPTS = $(am__append_12) local-kyua
