@WITH_ATF_TRUE@tests_integrationdir = $(pkgtestsdir)/integration
@WITH_ATF_TRUE@tests_integration_DATA = integration/Kyuafile
@WITH_ATF_TRUE@ATF_SH_BUILD = \
@WITH_ATF_TRUE@    $(MKDIR_P) integration; \
@WITH_ATF_TRUE@    echo "\#! $(ATF_SH)" >integration/$${name}; \
@WITH_ATF_TRUE@    echo "\# AUTOMATICALLY GENERATED FROM Makefile" >>integration/$${name}; \
@WITH_ATF_TRUE@    if [ -n "$${substs}" ]; then \
@WITH_ATF_TRUE@        cat $(srcdir)/integration/utils.sh $(srcdir)/integration/$${name}.sh \
@WITH_ATF_TRUE@            | sed "$${substs}" >>integration/$${name}; \
@WITH_ATF_TRUE@    else \
@WITH_ATF_TRUE@        cat $(srcdir)/integration/utils.sh $(srcdir)/integration/$${name}.sh \
@WITH_ATF_TRUE@            >>integration/$${name}; \
@WITH_ATF_TRUE@    fi; \
@WITH_ATF_TRUE@    chmod +x integration/$${name}

@WITH_ATF_TRUE@ATF_SH_DEPS = \
@WITH_ATF_TRUE@    $(srcdir)/integration/utils.sh \
@WITH_ATF_TRUE@    Makefile

