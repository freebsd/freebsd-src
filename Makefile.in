	echo " ( cd '$(DESTDIR)$(tests_utils_signalsdir)' && rm -f" $$files ")"; \
	cd "$(DESTDIR)$(tests_utils_signalsdir)" && $(am__rm_f) $$files

clean-tests_utils_signalsPROGRAMS:
	$(am__rm_f) $(tests_utils_signals_PROGRAMS)
	test -z "$(EXEEXT)" || $(am__rm_f) $(tests_utils_signals_PROGRAMS:$(EXEEXT)=)
install-tests_utils_sqlitePROGRAMS: $(tests_utils_sqlite_PROGRAMS)
	@$(NORMAL_INSTALL)
	@list='$(tests_utils_sqlite_PROGRAMS)'; test -n "$(tests_utils_sqlitedir)" || list=; \
	if test -n "$$list"; then \
	  echo " $(MKDIR_P) '$(DESTDIR)$(tests_utils_sqlitedir)'"; \
	  $(MKDIR_P) "$(DESTDIR)$(tests_utils_sqlitedir)" || exit 1; \
	fi; \
	for p in $$list; do echo "$$p $$p"; done | \
	sed 's/$(EXEEXT)$$//' | \
	while read p p1; do if test -f $$p \
	 || test -f $$p1 \
	  ; then echo "$$p"; echo "$$p"; else :; fi; \
	done | \
	sed -e 'p;s,.*/,,;n;h' \
	    -e 's|.*|.|' \
	    -e 'p;x;s,.*/,,;s/$(EXEEXT)$$//;$(transform);s/$$/$(EXEEXT)/' | \
	sed 'N;N;N;s,\n, ,g' | \
	$(AWK) 'BEGIN { files["."] = ""; dirs["."] = 1 } \
	  { d=$$3; if (dirs[d] != 1) { print "d", d; dirs[d] = 1 } \
	    if ($$2 == $$4) files[d] = files[d] " " $$1; \
	    else { print "f", $$3 "/" $$4, $$1; } } \
	  END { for (d in files) print "f", d, files[d] }' | \
	while read type dir files; do \
	    if test "$$dir" = .; then dir=; else dir=/$$dir; fi; \
	    test -z "$$files" || { \
	    echo " $(INSTALL_PROGRAM_ENV) $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=install $(INSTALL_PROGRAM) $$files '$(DESTDIR)$(tests_utils_sqlitedir)$$dir'"; \
	    $(INSTALL_PROGRAM_ENV) $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=install $(INSTALL_PROGRAM) $$files "$(DESTDIR)$(tests_utils_sqlitedir)$$dir" || exit $$?; \
	    } \
	; done

uninstall-tests_utils_sqlitePROGRAMS:
	@$(NORMAL_UNINSTALL)
	@list='$(tests_utils_sqlite_PROGRAMS)'; test -n "$(tests_utils_sqlitedir)" || list=; \
	files=`for p in $$list; do echo "$$p"; done | \
	  sed -e 'h;s,^.*/,,;s/$(EXEEXT)$$//;$(transform)' \
	      -e 's/$$/$(EXEEXT)/' \
	`; \
	test -n "$$list" || exit 0; \
	echo " ( cd '$(DESTDIR)$(tests_utils_sqlitedir)' && rm -f" $$files ")"; \
	cd "$(DESTDIR)$(tests_utils_sqlitedir)" && $(am__rm_f) $$files

clean-tests_utils_sqlitePROGRAMS:
	$(am__rm_f) $(tests_utils_sqlite_PROGRAMS)
	test -z "$(EXEEXT)" || $(am__rm_f) $(tests_utils_sqlite_PROGRAMS:$(EXEEXT)=)
