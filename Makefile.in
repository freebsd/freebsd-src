local-kyua: Makefile
	$(AM_V_GEN)echo '#!/bin/sh' >local-kyua.tmp; \
	echo 'env $(CHECK_ENVIRONMENT) $(TESTS_ENVIRONMENT)' \
	    '"$(abs_top_builddir)/kyua" \
	    --config='$(KYUA_CONFIG_FILE_FOR_CHECK)' \
	    "$${@}"' >>local-kyua.tmp; \
	chmod +x local-kyua.tmp; \
	mv -f local-kyua.tmp local-kyua
@WITH_ATF_TRUE@check-kyua: $(CHECK_KYUA_DEPS)
@WITH_ATF_TRUE@	@failed=no; \
@WITH_ATF_TRUE@	./local-kyua test \
@WITH_ATF_TRUE@	    --kyuafile='$(top_srcdir)/Kyuafile' --build-root='$(top_builddir)' \
@WITH_ATF_TRUE@	    || failed=yes; \
@WITH_ATF_TRUE@	if [ "$${failed}" = yes ]; then \
@WITH_ATF_TRUE@	    ./local-kyua report --results-file='$(abs_top_srcdir)' \
@WITH_ATF_TRUE@	        --verbose --results-filter=broken,failed; \
@WITH_ATF_TRUE@	    exit 1; \
@WITH_ATF_TRUE@	fi
@WITH_ATF_TRUE@installcheck-kyua:
@WITH_ATF_TRUE@	cd $(pkgtestsdir) && $(INSTALLCHECK_ENVIRONMENT) $(TESTS_ENVIRONMENT) \
@WITH_ATF_TRUE@	    kyua --config='$(KYUA_CONFIG_FILE_FOR_CHECK)' test; \
@WITH_ATF_TRUE@	ret=$$?; \
@WITH_ATF_TRUE@	echo $${ret}; \
@WITH_ATF_TRUE@	if [ -n "$$JUNIT_OUTPUT" ]; then \
@WITH_ATF_TRUE@	    cd $(pkgtestsdir) && $(TESTS_ENVIRONMENT) \
@WITH_ATF_TRUE@		    $(KYUA) --config='$(KYUA_CONFIG_FILE_FOR_CHECK)' \
@WITH_ATF_TRUE@		    report-junit --output="$$JUNIT_OUTPUT"; \
@WITH_ATF_TRUE@	    sed -i '.orig' 's/encoding="iso-8859-1"/encoding="utf-8"/' "$$JUNIT_OUTPUT"; \
@WITH_ATF_TRUE@	    rm -f "$$JUNIT_OUTPUT.orig"; \
@WITH_ATF_TRUE@	fi; \
@WITH_ATF_TRUE@	cd $(pkgtestsdir) && $(INSTALLCHECK_ENVIRONMENT) $(TESTS_ENVIRONMENT) \
@WITH_ATF_TRUE@	    kyua --config='$(KYUA_CONFIG_FILE_FOR_CHECK)' report \
@WITH_ATF_TRUE@	    --verbose --results-filter=broken,failed; \
@WITH_ATF_TRUE@	exit $${ret}
@CODE_COVERAGE_TRUE@@WITH_ATF_TRUE@CODE_COVERAGE_OUTPUT_DIR ?= code_coverage
@CODE_COVERAGE_TRUE@@WITH_ATF_TRUE@EXTRA_GENHTML_ARGS ?=

@CODE_COVERAGE_TRUE@@WITH_ATF_TRUE@installcheck-kyua-lcov: installcheck-kyua
@CODE_COVERAGE_TRUE@@WITH_ATF_TRUE@	mkdir -p $(CODE_COVERAGE_OUTPUT_DIR)/html
@CODE_COVERAGE_TRUE@@WITH_ATF_TRUE@	$(LCOV) --capture --directory $(srcdir) \
@CODE_COVERAGE_TRUE@@WITH_ATF_TRUE@	    --output-file $(CODE_COVERAGE_OUTPUT_DIR)/lcov.info
@CODE_COVERAGE_TRUE@@WITH_ATF_TRUE@	$(LCOV) --remove $(CODE_COVERAGE_OUTPUT_DIR)/lcov.info \
@CODE_COVERAGE_TRUE@@WITH_ATF_TRUE@	    $(CODE_COVERAGE_EXCLUDES) \
@CODE_COVERAGE_TRUE@@WITH_ATF_TRUE@	    --output-file $(CODE_COVERAGE_OUTPUT_DIR)/lcov-filtered.info
@CODE_COVERAGE_TRUE@@WITH_ATF_TRUE@	$(GENHTML) -o $(CODE_COVERAGE_OUTPUT_DIR)/html $(EXTRA_GENHTML_ARGS) \
@CODE_COVERAGE_TRUE@@WITH_ATF_TRUE@	    $(CODE_COVERAGE_OUTPUT_DIR)/lcov-filtered.info
@WITH_ATF_TRUE@dump-ulimits:
@WITH_ATF_TRUE@	@echo "Resource limits:"
@WITH_ATF_TRUE@	@{ \
@WITH_ATF_TRUE@	    ulimit -a | sed -e 's,$$, (soft),'; \
@WITH_ATF_TRUE@	    ulimit -a -H | sed -e 's,$$, (hard),'; \
@WITH_ATF_TRUE@	} | sort | sed -e 's,^,    ,'
@WITH_ATF_TRUE@	@echo
@WITH_ATF_FALSE@dist-no-atf:
@WITH_ATF_FALSE@	@echo "Sorry; cannot build a distfile without atf"
@WITH_ATF_FALSE@	@false
check-local: $(CHECK_LOCAL)
@CODE_COVERAGE_TRUE@mostlyclean-local: mostlyclean-code-coverage
@CODE_COVERAGE_TRUE@mostlyclean-code-coverage:
@CODE_COVERAGE_TRUE@	-for dir in $(CODE_COVERAGE_DIRS); do \
@CODE_COVERAGE_TRUE@	    find $$dir \( -name \*.gcda -or -name \*.gcno \) -delete -print; \
@CODE_COVERAGE_TRUE@	done

installcheck-local: $(INSTALLCHECK_TARGETS)
@WITH_DOXYGEN_TRUE@check-api-docs: api-docs/api-docs.tag
@WITH_DOXYGEN_TRUE@	@$(AWK) -f $(srcdir)/admin/check-api-docs.awk api-docs/doxygen.out

@WITH_DOXYGEN_TRUE@api-docs/api-docs.tag: $(builddir)/Doxyfile $(SOURCES)
@WITH_DOXYGEN_TRUE@	@$(MKDIR_P) api-docs
@WITH_DOXYGEN_TRUE@	@rm -f api-docs/doxygen.out api-docs/doxygen.out.tmp
@WITH_DOXYGEN_TRUE@	$(AM_V_GEN)$(DOXYGEN) $(builddir)/Doxyfile \
@WITH_DOXYGEN_TRUE@	    >api-docs/doxygen.out.tmp 2>&1 && \
@WITH_DOXYGEN_TRUE@	    mv api-docs/doxygen.out.tmp api-docs/doxygen.out
@WITH_DOXYGEN_TRUE@clean-api-docs:
@WITH_DOXYGEN_TRUE@	rm -rf api-docs
check-news:
	@case "$$(sed 15q "$(srcdir)/NEWS")" in \
	*"$(VERSION)"*) : ;; \
	*) \
	    echo "NEWS not updated; not releasing" 1>&2; \
	    exit 1 \
	    ;; \
	esac

clean-local: $(CLEAN_TARGETS)
clean-all:
	GIT="$(GIT)" $(SH) $(srcdir)/admin/clean-all.sh

dist-hook: $(DIST_HOOKS)

.PHONY: $(PHONY_TARGETS)

# vim: syntax=make:noexpandtab:shiftwidth=8:softtabstop=8

# Tell versions [3.59,3.63) of GNU make to not export all variables.
# Otherwise a system limit (for SysV at least) may be exceeded.
.NOEXPORT:

# Tell GNU make to disable its built-in pattern rules.
%:: %,v
%:: RCS/%,v
%:: RCS/%
%:: s.%
%:: SCCS/s.%
