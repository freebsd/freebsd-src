@WITH_ATF_TRUE@distclean-local: distclean-testsuite
@WITH_ATF_TRUE@distclean-testsuite:
@WITH_ATF_TRUE@	-rm -rf bootstrap/testsuite.dir
@WITH_ATF_TRUE@@target_srcdir@bootstrap/package.m4: $(top_srcdir)/configure.ac
@WITH_ATF_TRUE@	$(AM_V_GEN){ \
@WITH_ATF_TRUE@	echo '# Signature of the current package.'; \
@WITH_ATF_TRUE@	echo 'm4_define(AT_PACKAGE_NAME,      @PACKAGE_NAME@)'; \
@WITH_ATF_TRUE@	echo 'm4_define(AT_PACKAGE_TARNAME,   @PACKAGE_TARNAME@)'; \
@WITH_ATF_TRUE@	echo 'm4_define(AT_PACKAGE_VERSION,   @PACKAGE_VERSION@)'; \
@WITH_ATF_TRUE@	echo 'm4_define(AT_PACKAGE_STRING,    @PACKAGE_STRING@)'; \
@WITH_ATF_TRUE@	echo 'm4_define(AT_PACKAGE_BUGREPORT, @PACKAGE_BUGREPORT@)'; \
@WITH_ATF_TRUE@	} >$(srcdir)/bootstrap/package.m4

@WITH_ATF_TRUE@@target_srcdir@bootstrap/testsuite: $(srcdir)/bootstrap/testsuite.at \
@WITH_ATF_TRUE@                                    @target_srcdir@bootstrap/package.m4
@WITH_ATF_TRUE@	$(AM_V_GEN)autom4te --language=Autotest -I $(srcdir) \
@WITH_ATF_TRUE@	    -I $(srcdir)/bootstrap \
@WITH_ATF_TRUE@	    $(srcdir)/bootstrap/testsuite.at -o $@.tmp; \
@WITH_ATF_TRUE@	mv $@.tmp $@
@WITH_ATF_TRUE@check-bootstrap: @target_srcdir@bootstrap/testsuite $(check_PROGRAMS) \
@WITH_ATF_TRUE@                 $(CHECK_BOOTSTRAP_DEPS)
@WITH_ATF_TRUE@	cd bootstrap && $(CHECK_ENVIRONMENT) $(TESTS_ENVIRONMENT) \
@WITH_ATF_TRUE@	    ./testsuite
@TARGET_SRCDIR_EMPTY_FALSE@@WITH_ATF_TRUE@copy-bootstrap-testsuite:
@TARGET_SRCDIR_EMPTY_FALSE@@WITH_ATF_TRUE@	    cp -f @target_srcdir@bootstrap/testsuite bootstrap/testsuite
