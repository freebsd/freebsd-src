	  $(MKDIR_P) "$(DESTDIR)$(tests_utils_cmdlinedir)" || exit 1; \
	fi; \
	for p in $$list; do \
	  if test -f "$$p"; then d=; else d="$(srcdir)/"; fi; \
	  echo "$$d$$p"; \
	done | $(am__base_list) | \
	while read files; do \
	  echo " $(INSTALL_DATA) $$files '$(DESTDIR)$(tests_utils_cmdlinedir)'"; \
	  $(INSTALL_DATA) $$files "$(DESTDIR)$(tests_utils_cmdlinedir)" || exit $$?; \
	done

