install-tests_bootstrapSCRIPTS: $(tests_bootstrap_SCRIPTS)
	@$(NORMAL_INSTALL)
	@list='$(tests_bootstrap_SCRIPTS)'; test -n "$(tests_bootstrapdir)" || list=; \
	if test -n "$$list"; then \
	  echo " $(MKDIR_P) '$(DESTDIR)$(tests_bootstrapdir)'"; \
	  $(MKDIR_P) "$(DESTDIR)$(tests_bootstrapdir)" || exit 1; \
	fi; \
	for p in $$list; do \
	  if test -f "$$p"; then d=; else d="$(srcdir)/"; fi; \
	  if test -f "$$d$$p"; then echo "$$d$$p"; echo "$$p"; else :; fi; \
	done | \
	sed -e 'p;s,.*/,,;n' \
	    -e 'h;s|.*|.|' \
	    -e 'p;x;s,.*/,,;$(transform)' | sed 'N;N;N;s,\n, ,g' | \
	$(AWK) 'BEGIN { files["."] = ""; dirs["."] = 1; } \
	  { d=$$3; if (dirs[d] != 1) { print "d", d; dirs[d] = 1 } \
	    if ($$2 == $$4) { files[d] = files[d] " " $$1; \
	      if (++n[d] == $(am__install_max)) { \
		print "f", d, files[d]; n[d] = 0; files[d] = "" } } \
	    else { print "f", d "/" $$4, $$1 } } \
	  END { for (d in files) print "f", d, files[d] }' | \
	while read type dir files; do \
	     if test "$$dir" = .; then dir=; else dir=/$$dir; fi; \
	     test -z "$$files" || { \
	       echo " $(INSTALL_SCRIPT) $$files '$(DESTDIR)$(tests_bootstrapdir)$$dir'"; \
	       $(INSTALL_SCRIPT) $$files "$(DESTDIR)$(tests_bootstrapdir)$$dir" || exit $$?; \
	     } \
	; done

uninstall-tests_bootstrapSCRIPTS:
	@$(NORMAL_UNINSTALL)
	@list='$(tests_bootstrap_SCRIPTS)'; test -n "$(tests_bootstrapdir)" || exit 0; \
	files=`for p in $$list; do echo "$$p"; done | \
	       sed -e 's,.*/,,;$(transform)'`; \
	dir='$(DESTDIR)$(tests_bootstrapdir)'; $(am__uninstall_files_from_dir)
install-tests_integrationSCRIPTS: $(tests_integration_SCRIPTS)
	@$(NORMAL_INSTALL)
	@list='$(tests_integration_SCRIPTS)'; test -n "$(tests_integrationdir)" || list=; \
	if test -n "$$list"; then \
	  echo " $(MKDIR_P) '$(DESTDIR)$(tests_integrationdir)'"; \
	  $(MKDIR_P) "$(DESTDIR)$(tests_integrationdir)" || exit 1; \
	fi; \
	for p in $$list; do \
	  if test -f "$$p"; then d=; else d="$(srcdir)/"; fi; \
	  if test -f "$$d$$p"; then echo "$$d$$p"; echo "$$p"; else :; fi; \
	done | \
	sed -e 'p;s,.*/,,;n' \
	    -e 'h;s|.*|.|' \
	    -e 'p;x;s,.*/,,;$(transform)' | sed 'N;N;N;s,\n, ,g' | \
	$(AWK) 'BEGIN { files["."] = ""; dirs["."] = 1; } \
	  { d=$$3; if (dirs[d] != 1) { print "d", d; dirs[d] = 1 } \
	    if ($$2 == $$4) { files[d] = files[d] " " $$1; \
	      if (++n[d] == $(am__install_max)) { \
		print "f", d, files[d]; n[d] = 0; files[d] = "" } } \
	    else { print "f", d "/" $$4, $$1 } } \
	  END { for (d in files) print "f", d, files[d] }' | \
	while read type dir files; do \
	     if test "$$dir" = .; then dir=; else dir=/$$dir; fi; \
	     test -z "$$files" || { \
	       echo " $(INSTALL_SCRIPT) $$files '$(DESTDIR)$(tests_integrationdir)$$dir'"; \
	       $(INSTALL_SCRIPT) $$files "$(DESTDIR)$(tests_integrationdir)$$dir" || exit $$?; \
	     } \
	; done

uninstall-tests_integrationSCRIPTS:
	@$(NORMAL_UNINSTALL)
	@list='$(tests_integration_SCRIPTS)'; test -n "$(tests_integrationdir)" || exit 0; \
	files=`for p in $$list; do echo "$$p"; done | \
	       sed -e 's,.*/,,;$(transform)'`; \
	dir='$(DESTDIR)$(tests_integrationdir)'; $(am__uninstall_files_from_dir)

