# things set by configure

_MAKE_VERSION?=20251111

prefix?= /home/aakash/obj/bmake-install
srcdir= /mnt/d/Github_Projects/freebsd-src/contrib/bmake
CC= gcc
MAKE_OS?= 
MACHINE?= amd64
MACHINE_ARCH?= x86_64
DEFAULT_SYS_PATH?= .../share/mk:/home/aakash/obj/bmake-install/share/mk

EGREP = egrep
CPPFLAGS+= 
CFLAGS+= ${CPPFLAGS} -DHAVE_CONFIG_H
LDFLAGS+= 
LIBOBJS+=  ${LIBOBJDIR}stresep$U.o
LDADD+= 
USE_META?= yes
USE_FILEMON?= no
FILEMON_H?= 
BMAKE_PATH_MAX?= 1024
# used if MAXPATHLEN not defined
CPPFLAGS+= -DBMAKE_PATH_MAX=${BMAKE_PATH_MAX}
