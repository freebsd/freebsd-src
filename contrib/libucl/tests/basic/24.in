# A merging include whose values are scalars where this file has containers
arr_int [1, 2];

obj_str {
	key = value;
}

arr_null [1, 2];

arr_hi [1, 2];

obj_hi {
	key = value;
}

obj_key {
	key = value;
}

obj_brace {
	key = value;
}

