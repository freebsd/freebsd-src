.PRECIOUS: Makefile

lutok.pc: $(srcdir)/lutok.pc.in Makefile
	$(AM_V_GEN)sed -e 's#__INCLUDEDIR__#$(includedir)#g' \
	    -e 's#__LIBDIR__#$(libdir)#g' \
	    -e 's#__LUA_CFLAGS__#$(LUA_CFLAGS)#g' \
	    -e 's#__LUA_LIBS__#$(LUA_LIBS)#g' \
	    -e 's#__VERSION__#$(PACKAGE_VERSION)#g' \
	    <$(srcdir)/lutok.pc.in >lutok.pc.tmp; \
	mv lutok.pc.tmp lutok.pc
@WITH_ATF_TRUE@examples_test: $(srcdir)/examples_test.sh
@WITH_ATF_TRUE@	$(AM_V_GEN)sed -e 's,__ATF_SH__,$(ATF_SH),g' \
@WITH_ATF_TRUE@	    -e 's,__CXX__,$(CXX),g' \
@WITH_ATF_TRUE@	    -e 's,__EXAMPLESDIR__,$(examplesdir),g' \
@WITH_ATF_TRUE@	    -e 's,__LIBDIR__,$(libdir),g' \
@WITH_ATF_TRUE@	    <$(srcdir)/examples_test.sh >examples_test.tmp; \
@WITH_ATF_TRUE@	chmod +x examples_test.tmp; \
@WITH_ATF_TRUE@	rm -f examples_test; \
@WITH_ATF_TRUE@	mv examples_test.tmp examples_test

@HAVE_KYUA_TRUE@@WITH_ATF_TRUE@check-local: check-kyua
@HAVE_KYUA_TRUE@@WITH_ATF_TRUE@check-kyua:
@HAVE_KYUA_TRUE@@WITH_ATF_TRUE@	$(TESTS_ENVIRONMENT) kyua test \
@HAVE_KYUA_TRUE@@WITH_ATF_TRUE@	    --kyuafile='$(top_srcdir)/Kyuafile' --build-root='$(top_builddir)'

@HAVE_KYUA_TRUE@@WITH_ATF_TRUE@installcheck-local: installcheck-kyua
@HAVE_KYUA_TRUE@@WITH_ATF_TRUE@installcheck-kyua:
@HAVE_KYUA_TRUE@@WITH_ATF_TRUE@	cd $(testsdir) && $(TESTS_ENVIRONMENT) kyua test
@WITH_ATF_FALSE@dist-no-atf:
@WITH_ATF_FALSE@	@echo "Sorry; cannot build a distfile without atf"
@WITH_ATF_FALSE@	@false

# This should probably be html-local, but it seems better to generate the
# documentation in all cases to get warnings about missing documentation every
# time the code is modified.  (And, after all, the documentation is not
# installed so generating it unconditionally is not a big problem.)
@WITH_DOXYGEN_TRUE@all-local: api-docs/api-docs.tag

@WITH_DOXYGEN_TRUE@api-docs/api-docs.tag: $(builddir)/Doxyfile $(SOURCES)
@WITH_DOXYGEN_TRUE@	$(AM_V_GEN)rm -rf api-docs; \
@WITH_DOXYGEN_TRUE@	mkdir -p api-docs; \
@WITH_DOXYGEN_TRUE@	${DOXYGEN} $(builddir)/Doxyfile 2>&1 | tee api-docs/warnings; \
@WITH_DOXYGEN_TRUE@	rm -f api-docs/html/installdox
@WITH_DOXYGEN_TRUE@api-docs/html: api-docs/api-docs.tag
@WITH_DOXYGEN_TRUE@clean-api-docs:
@WITH_DOXYGEN_TRUE@	rm -rf api-docs
@WITH_DOXYGEN_FALSE@dist-no-doxygen:
@WITH_DOXYGEN_FALSE@	@echo "Sorry; cannot build a distfile without Doxygen"
@WITH_DOXYGEN_FALSE@	@false

install-data-local: install-api-docs
install-api-docs: install-docDATA
	@echo "Installing HTML documentation into $(DESTDIR)$(htmldir)"
	@if [ -d api-docs/html ]; then \
	    test -z "$(htmldir)" || $(MKDIR_P) "$(DESTDIR)$(htmldir)"; \
	    ( cd api-docs/html && tar cf - . ) | \
                ( cd "$(DESTDIR)$(htmldir)" && tar xf - ); \
	elif [ -d "$(srcdir)/api-docs/html" ]; then \
	    test -z "$(htmldir)" || $(MKDIR_P) "$(DESTDIR)$(htmldir)"; \
	    ( cd "$(srcdir)/api-docs/html" && tar cf - . ) | \
                ( cd "$(DESTDIR)$(htmldir)" && tar xf - ); \
	else \
	    echo "Doxygen not installed and prebuilt documents not found"; \
	fi

uninstall-local: uninstall-api-docs
uninstall-api-docs:
	find "$(DESTDIR)$(htmldir)" -type d -exec chmod 755 {} \;
	rm -rf "$(DESTDIR)$(htmldir)"

clean-local: $(CLEAN_TARGETS)
clean-all:
	GIT="$(GIT)" $(SH) $(srcdir)/admin/clean-all.sh

dist-hook: $(DIST_HOOKS)

.PHONY: ${PHONY_TARGETS}

# Tell versions [3.59,3.63) of GNU make to not export all variables.
# Otherwise a system limit (for SysV at least) may be exceeded.
.NOEXPORT:

# Tell GNU make to disable its built-in pattern rules.
%:: %,v
%:: RCS/%,v
%:: RCS/%
%:: s.%
%:: SCCS/s.%
