#
# QCOM -- Kernel config for Qualcomm Snapdragon mobile SoCs
#         UOS Mobile OS - Snapdragon flagship support
#
# Primary targets:
#   SM8650 - Snapdragon 8 Gen 3 (flagship 2024)
#   SM8550 - Snapdragon 8 Gen 2 (flagship 2023)
#   SM8450 - Snapdragon 8 Gen 1 (flagship 2022)
#   SC8280XP - Snapdragon 8cx Gen 3 (compute)
#
# Reference devices:
#   - OnePlus 12, Samsung S24 (SM8650)
#   - Xiaomi 13 Pro (SM8550)
#   - Lenovo ThinkPad X13s (SC8280XP - OpenBSD primary target)
#

cpu		ARM64
ident		UOS_QCOM_SNAPDRAGON

makeoptions	DEBUG=-g
makeoptions	WITH_CTF=1
makeoptions	WITH_KERNEL_BIN=1

# OpenBSD-style hardening compiler flags
# These match OpenBSD's default COPTS for ARM64:
makeoptions	CFLAGS+="-mbranch-protection=pac-ret+leaf+bti"
makeoptions	CFLAGS+="-fstack-protector-strong"
makeoptions	CFLAGS+="-D_FORTIFY_SOURCE=2"

# UOS Mobile Performance Tuning
makeoptions	COPTFLAGS="-O3"

include		"std.arm64"
include		"std.dev"
include		"std.qcom"

# ================================================================
# UOS Mobile + Security options
# ================================================================
options		MOBILE_OS
options		LOW_LATENCY
options		POWER_EFFICIENT

# ================================================================
# ARM64 Security hardware (OpenBSD always enables these)
# ================================================================
options		ARM64_BTI		# BTI: Block ROP/JOP
options		ARM64_PAC		# PAC: Pointer authentication
options		ARM64_UAO		# User Access Only (kernel)
options		PAN			# Privileged Access Never (always)

# ================================================================
# SMP (Snapdragon 8 Gen 3: 1x Cortex-X4 + 5x A720 + 2x A520)
# ================================================================
options		SMP
options		MAXCPU=8
options		HZ=250			# Mobile tick rate for deep sleep

# ================================================================
# Power and Thermal Management
# ================================================================
options		CPUFREQ_DT
device		coretemp
device		hwpmc

# ================================================================
# OpenBSD-inspired kernel security options
# ================================================================
options		UOS_SECURITY
options		UOS_WX_ENFORCE		# W^X: no page can be W and X
options		UOS_UNVEIL		# Filesystem restriction API
options		UOS_PLEDGE		# Syscall restriction via capsicum
options		CAPABILITIES		# FreeBSD capsicum (pledge equivalent)
options		MAC			# TrustedBSD MAC framework
options		MAC_SEEOTHERUIDS	# Prevent cross-UID proc enumeration
options		MAC_PORTACL		# Port access control (no low ports)
options		AUDIT			# Security event auditing
options		RACCT			# Resource containers
options		RCTL			# Resource limits per-process

# ================================================================
# Bionic / Android app compatibility
# ================================================================
options		COMPAT_LINUX64
options		COMPAT_LINUXKPI

# ================================================================
# Display / framebuffer
# ================================================================
device		vt
device		vt_efifb

# ================================================================
# Input
# ================================================================
device		hid
device		hidbus
device		hmt			# HID multitouch
device		usbhid

# ================================================================
# Storage
# ================================================================
device		geom
device		geom_part_gpt
device		mmc
device		mmcsd

# ================================================================
# Filesystems
# ================================================================
options		FFS
options		SOFTUPDATES
options		UFS_DIRHASH
options		TMPFS
options		ZFS
options		NULLFS
options		FDESCFS
options		PROCFS
options		LINPROCFS

# ================================================================
# Networking
# ================================================================
options		INET
options		INET6
options		SCTP
device		loop
device		ether
device		vlan
device		if_bridge
device		wlan
device		wlan_wep
device		wlan_ccmp
device		wlan_tkip

# ================================================================
# Debug (keep in until hardware bring-up complete)
# ================================================================
options		KDB
options		DDB
options		GDB
options		INVARIANTS
options		INVARIANT_SUPPORT
options		WITNESS
options		WITNESS_SKIPSPIN
options		MALLOC_DEBUG_MAXZONES=8
options		BOOTVERBOSE
