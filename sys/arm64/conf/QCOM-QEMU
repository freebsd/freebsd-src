#
# QCOM-QEMU -- Kernel configuration for QEMU arm64 virt machine
#              UOS Qualcomm testing environment
#
# Purpose: Test UOS Qualcomm kernel support in QEMU before real Snapdragon hardware.
#
# QEMU invocation:
#   qemu-system-aarch64 \
#     -M virt,gic-version=3 \
#     -cpu cortex-a72 \         # Or max to approximate Snapdragon cores
#     -smp 8 \                  # 8 vCPUs (typical for mobile)
#     -m 8G \
#     -bios /usr/share/qemu/edk2-aarch64-code.fd \
#     -drive file=uos-qcom.img,format=raw,if=virtio \
#     -device virtio-gpu-pci \  # GUI framebuffer
#     -display gtk \           # GTK window (GUI mode)
#     -device virtio-keyboard-pci \
#     -device virtio-mouse-pci \
#     -device virtio-net-pci,netdev=net0 \
#     -netdev user,id=net0,hostfwd=tcp::2222-:22 \
#     -serial stdio \
#     -monitor telnet::4445,server,nowait
#

cpu		ARM64
ident		QCOM_QEMU

makeoptions	DEBUG=-g
makeoptions	WITH_CTF=1
# Build optimizations
makeoptions	COPTFLAGS="-O3 -pipe -fno-strict-aliasing"

# OpenBSD-style hardening compiler flags matching native QCOM config
makeoptions	CFLAGS+="-mbranch-protection=pac-ret+leaf+bti"
makeoptions	CFLAGS+="-fstack-protector-strong"
makeoptions	CFLAGS+="-D_FORTIFY_SOURCE=2"

# Base ARM64 standard configs
include		"std.arm64"
include		"std.dev"

# VirtIO / QEMU virt machine support
include		"std.virt"

# Provide base qcom configurations
include		"std.qcom"

# ======================================================================
# UOS Mobile + Security options
# ======================================================================
options		MOBILE_OS
options		LOW_LATENCY
options		POWER_EFFICIENT

# ======================================================================
# ARM64 Security hardware
# ======================================================================
options		ARM64_BTI		# BTI: Block ROP/JOP
options		ARM64_PAC		# PAC: Pointer authentication
options		ARM64_UAO		# User Access Only (kernel)
options		PAN			# Privileged Access Never

# ======================================================================
# QEMU GIC v3 interrupt controller
# ======================================================================
options		FDT
device		gic
device		gic_v3
device		gic_v3_its

# ======================================================================
# VirtIO Devices (QEMU virt machine)
# ======================================================================
device		virtio
device		virtio_pci		# VirtIO over PCIe
device		virtio_mmio		# VirtIO over MMIO
device		virtio_blk		# VirtIO block (disk image)
device		virtio_scsi		# VirtIO SCSI
device		vtnet			# VirtIO network (vtnet0)
device		virtio_gpu		# VirtIO GPU (GTK GUI window)
device		virtio_input		# VirtIO keyboard/mouse
device		virtio_console		# VirtIO console

# ======================================================================
# Display / Framebuffer (for GUI mode)
# ======================================================================
device		vt			# Virtual terminal
device		vt_vga			# VGA text mode fallback
device		vt_efifb		# EFI framebuffer
options		TERMINAL_KERN_ATTR=(FG_WHITE|BG_BLACK)

# ======================================================================
# PCI/PCIe (QEMU virt uses PCIe)
# ======================================================================
device		pci
device		pci_host_generic	# Generic PCI host bridge

# ======================================================================
# SCSI / Storage
# ======================================================================
device		scbus
device		da			# SCSI disk

# ======================================================================
# Serial console (QEMU pl011 UART)
# ======================================================================
device		uart
device		pl011

# ======================================================================
# Networking
# ======================================================================
options		INET
options		INET6
device		loop
device		ether
device		miibus

# ======================================================================
# Filesystems
# ======================================================================
options		FFS
options		SOFTUPDATES
options		UFS_DIRHASH
options		TMPFS
options		NULLFS
options		FDESCFS
options		PROCFS
options		LINPROCFS
options		CD9660		# ISO 9660 for bootable images

# ======================================================================
# Memory
# ======================================================================
options		SMP
options		MAXCPU=8

# ======================================================================
# Scheduler for QEMU testing
# ======================================================================
options		SCHED_ULE
options		PREEMPTION
options		HZ=1000		# Full 1kHz for accurate latency testing

# ======================================================================
# Linux compatibility (test Bionic shims in QEMU first)
# ======================================================================
options		COMPAT_LINUX64
options		COMPAT_LINUXKPI

# ======================================================================
# OpenBSD-inspired kernel security options
# ======================================================================
options		UOS_SECURITY
options		UOS_WX_ENFORCE		# W^X: no page can be W and X
options		UOS_UNVEIL		# Filesystem restriction API
options		UOS_PLEDGE		# Syscall restriction via capsicum
options		CAPABILITIES		# FreeBSD capsicum
options		MAC			# TrustedBSD MAC framework
options		MAC_SEEOTHERUIDS	# Prevent cross-UID proc enumeration
options		MAC_PORTACL		# Port access control (no low ports)
options		AUDIT			# Security event auditing
options		RACCT			# Resource containers
options		RCTL			# Resource limits per-process

# ======================================================================
# Debug/development (always on in QEMU)
# ======================================================================
options		KDB
options		DDB
options		GDB			# Remote GDB stub (for QEMU -s -S)
options		INVARIANTS
options		INVARIANT_SUPPORT
options		WITNESS			# Lock order tracking
options		WITNESS_SKIPSPIN
options		MALLOC_DEBUG_MAXZONES=8
