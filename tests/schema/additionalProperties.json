[
    {
        "description":
            "additionalProperties being false does not allow other properties",
        "schema": {
            "properties": {"foo": {}, "bar": {}},
            "patternProperties": { "^v": {} },
            "additionalProperties": false
        },
        "tests": [
            {
                "description": "no additional properties is valid",
                "data": {"foo": 1},
                "valid": true
            },
            {
                "description": "an additional property is invalid",
                "data": {"foo" : 1, "bar" : 2, "quux" : "boom"},
                "valid": false
            },
            {
                "description": "ignores non-objects",
                "data": [1, 2, 3],
                "valid": true
            },
            {
                "description": "patternProperties are not additional properties",
                "data": {"foo":1, "vroom": 2},
                "valid": true
            },
            {
                "description": "an additional property next to a pattern property is invalid",
                "data": {"vroom": 2, "quux": "boom"},
                "valid": false
            }
        ]
    },
    {
        "description":
            "additionalProperties allows a schema which should validate",
        "schema": {
            "properties": {"foo": {}, "bar": {}},
            "additionalProperties": {"type": "boolean"}
        },
        "tests": [
            {
                "description": "no additional properties is valid",
                "data": {"foo": 1},
                "valid": true
            },
            {
                "description": "an additional valid property is valid",
                "data": {"foo" : 1, "bar" : 2, "quux" : true},
                "valid": true
            },
            {
                "description": "an additional invalid property is invalid",
                "data": {"foo" : 1, "bar" : 2, "quux" : 12},
                "valid": false
            }
        ]
    },
    {
        "description":
            "additionalProperties schema applies to properties no pattern matches",
        "schema": {
            "patternProperties": {"^v": {}},
            "additionalProperties": {"type": "boolean"}
        },
        "tests": [
            {
                "description": "a pattern property is not checked against it",
                "data": {"vroom": 1},
                "valid": true
            },
            {
                "description": "an additional valid property is valid",
                "data": {"vroom": 1, "quux": true},
                "valid": true
            },
            {
                "description": "an additional invalid property is invalid",
                "data": {"vroom": 1, "quux": 12},
                "valid": false
            }
        ]
    },
    {
        "description": "additionalProperties are allowed by default",
        "schema": {"properties": {"foo": {}, "bar": {}}},
        "tests": [
            {
                "description": "additional properties are allowed",
                "data": {"foo": 1, "bar": 2, "quux": true},
                "valid": true
            }
        ]
    },
    {
        "description":
            "additionalProperties with a repeated patternProperties that is not an object",
        "schema": {
            "patternProperties": {"^x": {}},
            "patternProperties": [{}],
            "additionalProperties": false
        },
        "tests": [
            {
                "description": "a property matching the first patterns is checked against an invalid schema",
                "data": {"x": 1},
                "valid": false
            },
            {
                "description": "an additional property is checked against an invalid schema",
                "data": {"y": 1},
                "valid": false
            }
        ]
    },
    {
        "description":
            "additionalProperties uses all of repeated patternProperties",
        "schema": {
            "patternProperties": {"^x": {}},
            "patternProperties": {"^y": {"type": "string"}},
            "additionalProperties": false
        },
        "tests": [
            {
                "description": "a property matching the first patterns is valid",
                "data": {"x": 1},
                "valid": true
            },
            {
                "description": "a property matching the repeated patterns is valid",
                "data": {"y": "s"},
                "valid": true
            },
            {
                "description": "a property matching no patterns is invalid",
                "data": {"z": 1},
                "valid": false
            }
        ]
    },
    {
        "description":
            "additionalProperties checks each of repeated values on its own",
        "schema": {
            "properties": {
                "v": {"properties": {"a": {}}, "additionalProperties": false}
            }
        },
        "tests": [
            {
                "description": "an object followed by an array is valid",
                "data": {"v": {"a": 1}, "v": [1]},
                "valid": true
            },
            {
                "description": "an object followed by a number is valid",
                "data": {"v": {"a": 1}, "v": 1},
                "valid": true
            },
            {
                "description": "an additional property in a later object is invalid",
                "data": {"v": {"a": 1}, "v": {"b": 1}},
                "valid": false
            }
        ]
    }
]
