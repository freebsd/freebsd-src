#!/bin/sh

PROG=${TEST_BINARY_DIR}/test_basic

for _tin in ${TEST_DIR}/basic/*.in ; do
	_t=`echo $_tin | sed -e 's/.in$//'`
	_out=${TEST_OUT_DIR}/basic.out
	$PROG $_t.in $_out
	if [ $? -ne 0 ] ; then
		echo "Test: $_t failed, output:"
		cat $_out
		rm $_out
		exit 1
	fi
	if [ -f $_t.res ] ; then
	diff -s $_out $_t.res -u 2>/dev/null
		if [ $? -ne 0 ] ; then
			rm $_out
			echo "Test: $_t output mismatch"
			exit 1
		fi
	fi
	rm $_out
	# FD interface, JSON, compact JSON and YAML output, saved comments,
	# macros as comments, and both: the output must parse back in each
	for _flags in "-f" "-j" "-c -j" "-y" "-C" "-M" "-M -C" ; do
		$PROG $_flags $_t.in > $_out
		if [ $? -ne 0 ] ; then
			echo "Test: $_t failed with $_flags, output:"
			cat $_out
			rm $_out
			exit 1
		fi
		rm $_out
	done
done


