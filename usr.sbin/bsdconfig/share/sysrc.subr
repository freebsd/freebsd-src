############################################################ INFORMATION
#
# Compatibility shim: sources the canonical sysrc.subr from /usr/share/sysrc/
# and loads bsdconfig-specific i18n messages afterward.
#
############################################################ INCLUDES

BSDCFG_SHARE="/usr/share/bsdconfig"
[ "$_COMMON_SUBR" ] || . $BSDCFG_SHARE/common.subr || exit 1

f_include /usr/share/sysrc/sysrc.subr

BSDCFG_LIBE="/usr/libexec/bsdconfig"
f_dprintf "%s: loading includes..." sysrc.subr
f_include_lang $BSDCFG_LIBE/include/messages.subr

############################################################ MAIN

f_dprintf "%s: Successfully loaded." sysrc.subr

fi # ! $_BSDCONFIG_SYSRC_SUBR
