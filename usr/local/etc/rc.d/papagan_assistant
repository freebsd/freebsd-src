#!/bin/sh
# PROVIDE: papagan_assistant
# REQUIRE: DAEMON
# KEYWORD: shutdown

. /etc/rc.subr

name="papagan_assistant"
rcvar=${name}_enable
: ${papagan_assistant_enable:="NO"}
: ${papagan_assistant_user:="root"}
: ${papagan_assistant_port:="8085"}
command="/usr/local/bin/papagan-assistant"
command_args=""

load_rc_config $name
run_rc_command "$1"
